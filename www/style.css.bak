/* 🌞 Maquerina Mundo – Solarpunk Theme
   A luminous harmony of sunlight, technology, and ecology.
   Designed for balance, beauty, and hope.
---------------------------------------------------------------*/

/* ===== Global Variables ===== */
:root {
  --gold-solar: #E3C567;          /* Solar gold */
  --green-leaf: #6BBF8F;          /* Vibrant eco-green */
  --green-dark: #243E36;          /* Deep forest green */
  --green-soft: #A6D49F;          /* Gentle plant tone */
  --mint-glow: #88C9BF;           /* Cool cyan glow */
  --text-light: #E9F2E2;          /* Light text */
  --text-subtle: #CDE1C3;         /* Subtle neutral text */
  --bg-dark: linear-gradient(180deg, #1E3029 0%, #0E1815 100%);
  --glass-border: rgba(255, 255, 255, 0.1);
  --shadow-deep: 0 0 40px rgba(227, 197, 103, 0.15);
  --shadow-soft: 0 6px 20px rgba(0, 0, 0, 0.3);
  --font-main: 'Outfit', 'Poppins', 'Segoe UI', sans-serif;
}

/* ===== Base ===== */
body, html {
  height: 100%;
  background: var(--bg-dark) fixed;
  color: var(--text-light);
  font-family: var(--font-main);
  margin: 0;
  padding: 0;
  overflow-x: hidden;
}

/* Layout: make body a column flex container so page content can grow and
   naturally push the footer to the bottom of the viewport. This prevents the
   footer from appearing halfway down pages with charts. */
body {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

/* Ensure main content containers expand to fill available space (so the
   footer sits at the bottom of the page). The app uses Bootstrap containers; we
   target common wrapper classes conservatively. */
.container, .container-fluid, .page-content, .bs-content, .page {
  flex: 1 0 auto;
}

/* Footer should not shrink and should remain visible at the bottom */
.site-footer {
  flex-shrink: 0;
}

/* ===== Navbar ===== */
.navbar {
  background: rgba(36, 62, 54, 0.9) !important;
  backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--glass-border);
}

.nav-link {
  color: var(--text-light) !important;
  font-weight: 500;
  transition: all 0.3s ease;
}

.nav-link.active {
  background-color: rgba(227, 197, 103, 0.25) !important;
  border-radius: 10px;
  color: var(--gold-solar) !important;
}

/* ===== Hero Section (Home Page) ===== */
.mm-hero {
  border-radius: 24px;
  padding: 80px 40px;
  text-align: center;
  color: var(--text-light);
  text-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
  box-shadow: 0 0 60px rgba(227, 197, 103, 0.15);
  background: linear-gradient(
              rgba(30, 48, 41, 0.6),
              rgba(14, 24, 21, 0.85)
            ),
            url("solar.JPG") center/35% no-repeat;
  border: 2px solid var(--gold-solar);
}

.mm-hero h1 {
  color: var(--gold-solar);
  font-weight: 700;
  font-size: 2.4rem;
  letter-spacing: 0.3px;
}

.mm-sub {
  color: var(--text-subtle);
  font-size: 1.1rem;
  line-height: 1.6;
  max-width: 700px;
  margin: 0 auto 15px;
  box-shadow: 0 0 60px rgba(227, 197, 103, 0.15);
  background: linear-gradient(
              rgba(30, 48, 41, 0.6),
              rgba(14, 24, 21, 0.85)
            ),
            url("solar.JPG") center/cover no-repeat;
  /* make the hero background appear more zoomed-out on larger screens */
  background-size: 35% !important;
  background-position: center center !important;
  align-items: center;
  justify-content: center;
}

/* Modern, editorial hero quote — no boxed container */
.mm-hero-quote-text {
  font-family: 'Georgia', 'Times New Roman', serif;
  font-style: italic;
  color: #FFFDF8;
  font-size: 1.4rem;
  max-width: 820px;
  line-height: 1.3;
  margin: 10px auto 0 auto;
  text-align: center;
  letter-spacing: 0.2px;
  position: relative;
  text-shadow: 0 6px 22px rgba(0,0,0,0.6);
}

.mm-hero-quote-author {
  display: block;
  margin-top: 12px;
  font-style: normal;
  color: rgba(233,242,226,0.9);
  font-weight: 700;
  font-size: 0.95rem;
  letter-spacing: 0.6px;
}

/* Lower the hero quote visually without changing hero size. On large screens
   move the quote further down using a relative top offset. Keep small screens
   unchanged to avoid layout issues. */
@media (min-width: 769px) {
  .mm-hero-quote-text {
    transform: translateY(28px); /* push quote down inside hero */
  }
  .mm-hero {
    padding-top: 80px; /* keep top padding similar but allow extra room */
    padding-bottom: 60px; /* ensure hero still reserves space for the lowered quote */
  }
}

@media (max-width: 768px) {
  /* On narrow screens, keep the quote closer to top to avoid cutting it off */
  .mm-hero-quote-text { transform: translateY(0); }
}

/* Decorative large quote mark */
.site-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px 24px;
  color: var(--text-light); /* match the color used in card headings */
  font-size: 0.95rem;
  /* place footer above background and UI elements */
  position: relative;
  z-index: 99999;
  background: linear-gradient(90deg, rgba(227,197,103,0.22), rgba(227,197,103,0.14));
  border-top: 1px solid rgba(255,255,255,0.06);
  backdrop-filter: blur(6px);
}

.site-footer-left { text-align: left; font-weight: 600; }
.site-footer-right { text-align: right; font-weight: 600; }

/* Keep footer dynamically in-flow. Use modest bottom padding so the footer
   doesn't visually collide with content on shorter pages, while allowing
   long pages to naturally push the footer down. */
.page-bg-plantdash, .page-bg-climateexplorer, .page-bg-datatable, .mm-hero, .mm-card {
  padding-bottom: 20px; /* modest breathing room above footer */
}

/* Extra bottom padding for pages that contain large graphs/tables so the footer
   never sits halfway over charts on medium-height viewports */
@media (min-height: 700px) {
  .page-bg-plantdash, .page-bg-datatable { padding-bottom: 120px; }
}

/* ===== Cards & Boxes ===== */
.mm-card {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--glass-border);
  border-radius: 18px;
  padding: 25px;
  backdrop-filter: blur(8px);
  box-shadow: var(--shadow-soft);
  transition: transform 0.25s ease, box-shadow 0.3s ease;
}

.mm-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 0 25px rgba(227, 197, 103, 0.25);
}

/* Modern select styling */
.shiny-input-container .selectize-input,
.shiny-input-container select.form-control {
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.08);
  color: var(--text-light);
  border-radius: 10px;
  padding: 10px 12px;
  box-shadow: 0 6px 18px rgba(36,62,54,0.2);
}

.shiny-input-container .selectize-input:focus,
.shiny-input-container select.form-control:focus {
  outline: none;
  border-color: var(--green-leaf);
  box-shadow: 0 8px 26px rgba(107,191,143,0.14);
}

/* Add safe spacing between stacked plot outputs and enforce a min height so they don't collapse */
.mm-card .plotly, .mm-card .leaflet-container {
  margin-bottom: 12px;
  min-height: 140px;
}

/* Modern plot tooltip and title tweaks */
.plotly .modebar, .plotly .legend {
  border-radius: 8px;
}

/* give charts a subtle inner glow */
.plotly, .leaflet-container {
  background: linear-gradient(180deg, rgba(255,255,255,0.01), rgba(0,0,0,0.02));
}

/* Gold frame highlight */
.mm-framed {
  border: 2px solid var(--gold-solar) !important;
  box-shadow: 0 0 18px rgba(227, 197, 103, 0.25);
}

/* Centered text in feature boxes */
.mm-card h4, .mm-card p, .mm-card .mm-btn {
  text-align: center;
}

/* Plant dashboard grid: responsive 2x2 layout with equal height cards */
.mm-plant-grid {
  display: grid;
  gap: 30px; /* increased gap as requested */
  grid-template-columns: repeat(auto-fit, minmax(420px, 1fr));
  grid-auto-rows: 1fr; /* make rows equal height */
  align-items: start;
}

.mm-plant-grid .mm-card {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  height: 100%;
  padding: 22px; /* consistent inner padding */
  min-height: 420px; /* ensure balanced card height */
  box-sizing: border-box;
}

/* Make the map and larger plot items span two columns on desktop */
.mm-plant-grid .leaflet-container,
.mm-plant-grid .plotly, /* ensure the plotly wrapper expands */
.mm-plant-grid .plotly-graph-div {
  width: 100% !important;
  height: calc(100% - 12px) !important; /* keep small breathing room inside card */
  flex: 1 1 auto !important;
  display: block !important;
}

/* Ensure the direct .plotly wrapper fills available vertical space */
.mm-plant-grid .plotly {
  display: flex !important;
  flex-direction: column !important;
}

.mm-plant-grid .plotly .plotly-graph-div {
  flex: 1 1 auto !important;
}

@media (max-width: 980px) {
  .mm-plant-grid { grid-template-columns: 1fr; }
}

/* Add breathing room around the dashboard section so cards don't touch navbar/footer */
.page-bg-plantdash, .page-bg-climateexplorer {
  margin-top: 28px;
  margin-bottom: 32px;
  padding-top: 6px; /* small internal padding to separate from navbar */
}

/* On wider screens, push the main grid away from the sidebar for breathing room */
@media (min-width: 980px) {
  .page-bg-plantdash .mm-plant-grid { margin-left: 28px; }
  /* If the sidebar card is present, ensure it keeps its fixed visual width */
  .page-bg-plantdash .mm-card.mm-no-expand { max-width: 340px; }
}

/* Also apply consistent spacing and min-heights to climate explorer cards */
.page-bg-climateexplorer .mm-card {
  min-height: 420px;
  padding: 22px;
}

/* Ensure control bar / dropdown stays aligned with grid in climate explorer */
@media (min-width: 980px) {
  .page-bg-climateexplorer .mm-card:first-child { max-width: 340px; }
  .page-bg-climateexplorer .mm-card:first-child + .mm-card { margin-left: 28px; }
}

/* Decorative symbols for the three feature cards: placed absolutely in the
   upper-left corner so they don't change text flow. Use flex + min-height to
   equalize box heights and center content vertically. */
.mm-feature {
  position: relative;
  min-height: 300px; /* equalize heights across feature cards */
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding-top: 20px; /* give a little breathing room for the glyph */
}
.mm-feature h4 { padding-left: 0; }
.mm-feature::before {
  position: absolute;
  left: 12px;
  top: 12px;
  font-size: 44px;
  color: var(--gold-solar);
  pointer-events: none; /* don't interfere with clicks/text selection */
}
.mm-feature-nasa::before { content: '\2699'; /* gear */ }
.mm-feature-solarpunk::before { content: '\2600'; /* sun */ }
.mm-feature-news::before { content: '\2709'; /* envelope */ }

/* Feature row placement and spacing: ensure a larger gap below the hero and
   avoid overlapping the footer. The bottom margin provides breathing room. */
.mm-feature-row {
  margin-top: 48px; /* extra vertical gap between hero and feature cards */
  margin-bottom: 48px; /* prevent overlap with footer on short pages */
  padding-left: 6px;
  padding-right: 6px;
}

/* Sidebar label style to match the correlation text color */
.mm-sidebar-label {
  color: var(--text-light); /* matches the correlation text color used inline */
  font-weight: 600;
  margin-bottom: 8px;
}

/* Card title used inside framed cards (e.g., sidebar 'Filter') */
.mm-card-title {
  color: var(--text-light);
  font-weight: 700;
  margin: 0 0 10px 0;
  text-align: left;
}

/* ===== Buttons ===== */
.mm-btn, .btn {
  border-radius: 12px !important;
  padding: 10px 20px;
  border: 1px solid rgba(227, 197, 103, 0.6);
  color: var(--gold-solar);
  background: transparent;
  font-weight: 600;
  transition: background 0.3s ease, color 0.3s ease, transform 0.2s ease;
}

.mm-btn:hover, .btn:hover {
  background: var(--gold-solar);
  color: var(--green-dark);
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(227, 197, 103, 0.3);
}

/* ===== Input + Sidebar Labels ===== */
label, .control-label, .form-label,
.irs-single, .irs-min, .irs-max, .irs-grid-text {
  color: var(--text-light) !important;
  font-weight: 500;
}

.irs--shiny .irs-bar {
  background: var(--gold-solar) !important;
}

/* ===== Plotly, Leaflet, and Data Table Borders ===== */
.plotly, .leaflet-container, .dataTables_wrapper {
  border: 2px solid var(--gold-solar) !important;
  border-radius: 14px;
  box-shadow: 0 0 18px rgba(227, 197, 103, 0.25);
  overflow: hidden;
}

/* ===== Data Table Enhancements ===== */
.dataTables_wrapper .dataTables_filter input {
  background: rgba(255, 255, 255, 0.08);
  border-radius: 8px;
  color: var(--text-light);
  border: 1px solid rgba(255, 255, 255, 0.15);
}

.dataTables_wrapper .dataTables_filter label {
  color: var(--text-subtle);
}

/* ===== Footer ===== */
.mm-footer {
  margin-top: 25px;
  text-align: center;
  color: var(--text-subtle);
  font-size: 0.95rem;
  font-style: italic;
}

/* ===== Scrollbar ===== */
::-webkit-scrollbar {
  width: 8px;
}
::-webkit-scrollbar-track {
  background: transparent;
}
::-webkit-scrollbar-thumb {
  background: var(--green-leaf);
  border-radius: 4px;
}
::-webkit-scrollbar-thumb:hover {
  background: var(--gold-solar);
}

/* ===== Animations ===== */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

.fade-in {
  animation: fadeIn 0.7s ease forwards;
}

/* ===== Responsive Tweaks ===== */
@media (max-width: 768px) {
  .mm-hero h1 { font-size: 1.9rem; }
  .mm-sub { font-size: 1rem; }
  .mm-card { padding: 18px; }
  .mm-hero-quote-text { font-size: 0.95rem; }
  /* restore cover on small screens for best cropping */
  .mm-hero { background-size: cover !important; }
}

/* additional responsive tweaks for glyphs and spacing */
@media (max-width: 480px) {
  .mm-feature h4 { padding-left: 44px; }
  .mm-feature h4::before { font-size: 22px; left: 8px; }
  .mm-hero { background-size: cover !important; background-position: center top !important; }
}

/* ===== Hover-expand widget behavior ===== */
/* Make internal graphs slightly smaller so they don't feel squeezed */
.mm-card .plotly,
.mm-card .plotly .plotly-graph-div,
.mm-card .leaflet-container {
  /* make inner plots slightly smaller in normal view so they don't feel squeezed */
  transform: scale(0.90);
  transform-origin: center center;
  transition: transform 260ms ease, box-shadow 260ms ease, width 260ms ease, height 260ms ease;
}

/* Container when expanded — fixed, full-viewport, elevated */
.expanded-widget {
  /* center as a square that fits within the viewport */
  position: fixed !important;
  top: 50% !important;
  left: 50% !important;
  width: min(92vw, 92vh) !important;
  height: min(92vw, 92vh) !important;
  transform: translate(-50%, -50%) !important;
  margin: 0 !important;
  padding: 12px !important;
  border-radius: 12px !important;
  z-index: 99999 !important;
  box-shadow: 0 30px 80px rgba(0,0,0,0.65) !important;
  transition: all 320ms cubic-bezier(.2,.9,.2,1) !important;
  background: linear-gradient(180deg, rgba(0,0,0,0.55), rgba(0,0,0,0.6)) !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
}

/* Ensure Plotly / Leaflet children stretch to fill expanded square and are centered */
.expanded-widget .plotly-graph-div,
.expanded-widget .leaflet-pane,
.expanded-widget .leaflet-container,
.expanded-widget .html-widget {
  width: 100% !important;
  height: 100% !important;
  display: block !important;
}

/* If a plotly wrapper exists, ensure its inner container uses flex to center content */
.expanded-widget .plotly {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
}

/* Close button for expanded widgets */
.expanded-widget .expand-close {
  position: absolute;
  top: 10px;
  right: 10px;
  width: 36px;
  height: 36px;
  border-radius: 18px;
  background: rgba(0,0,0,0.6);
  color: var(--text-light);
  border: 1px solid rgba(255,255,255,0.08);
  font-size: 20px;
  line-height: 34px;
  text-align: center;
  cursor: pointer;
  box-shadow: 0 6px 18px rgba(0,0,0,0.6);
  transition: transform 160ms ease, background 160ms ease;
}
.expanded-widget .expand-close:hover { transform: scale(1.06); background: rgba(0,0,0,0.75); }

/* overlay used when a card is expanded */
.mm-expand-overlay {
  backdrop-filter: blur(3px);
}

/* utility classes for image-backed transparent boxes */
.mm-bg-nasa {
  background-image: url('nasa.webp');
  background-size: cover;
  background-position: center center;
  background-repeat: no-repeat;
  /* darken the image and add transparency so text remains readable */
  background-color: rgba(0,0,0,0.36);
  background-blend-mode: multiply;
}
.mm-bg-solarpunk {
  background-image: url('solarpunk.webp');
  background-size: cover;
  background-position: center center;
  background-repeat: no-repeat;
  background-color: rgba(0,0,0,0.36);
  background-blend-mode: multiply;
}
.mm-bg-climate2 {
  background-image: url('climate2.jpeg');
  background-size: cover;
  background-position: center center;
  background-repeat: no-repeat;
  background-color: rgba(0,0,0,0.36);
  background-blend-mode: multiply;
}

/* page background utilities for dashboards */
.page-bg-plantdash {
  background-image: url('plantdash.jpg');
  background-size: cover;
  background-position: center center;
  background-repeat: no-repeat;
  background-color: rgba(0,0,0,0.22);
  background-blend-mode: overlay;
}
.page-bg-climateexplorer {
  background-image: url('climate.jpg');
  background-size: cover;
  background-position: center center;
  background-repeat: no-repeat;
  background-color: rgba(0,0,0,0.24);
  background-blend-mode: overlay;
}
.page-bg-datatable {
  background-image: url('rdata.webp');
  background-size: cover;
  background-position: center center;
  background-repeat: no-repeat;
  background-color: rgba(0,0,0,0.24);
  background-blend-mode: overlay;
}

/* Small subtle scale-up on hover before full expansion to indicate interactivity */
.mm-card .plotly:hover .plotly-graph-div,
.mm-card .leaflet-container:hover {
  transform: scale(0.96);
}

/* Direction/instruction text used inside panels */
.direction-text {
  color: var(--text-subtle);
  font-size: 0.95rem;
  margin: 6px 0 12px 0;
  font-weight: 500;
}
